# Produção: mantenha este arquivo sem segredos reais. Cadastre os valores no
# gerenciador de variáveis do provedor de deploy (Vercel, container, etc.).
NODE_ENV=production

# Banco de dados — obrigatório. Use TLS quando o banco não for local.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/sadpf_db?sslmode=require"

# Autenticação — obrigatório. Gere um segredo aleatório com no mínimo 32 caracteres.
# Exemplo: openssl rand -base64 48
SADPF_SECRET="substitua-por-um-segredo-aleatorio-com-no-minimo-32-caracteres"

# URL pública canônica, usada nos links de primeiro acesso/redefinição de senha.
APP_URL="https://sadpf.exemplo.gov.br"

# E-mail de primeiro acesso — obrigatório para contas ainda sem senha.
RESEND_API_KEY="re_substitua_pela_chave_do_resend"
EMAIL_FROM="SADPF <acesso@exemplo.gov.br>"

# Ative apenas se a aplicação estiver atrás de proxy/CDN que sobrescreve
# X-Forwarded-For (por exemplo, Vercel, Nginx ou Ingress devidamente configurado).
TRUST_PROXY=true

# Storage: escolha exatamente um provedor: local, supabase, s3 ou minio.
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=sadpf-documentos

# Supabase Storage — obrigatório quando STORAGE_PROVIDER=supabase.
# A URL e a chave devem pertencer ao MESMO projeto Supabase.
# Nunca use NEXT_PUBLIC_ para esta chave e nunca a exponha no navegador.
SUPABASE_URL="https://seu-project-ref.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_substitua_pela_chave_secreta_do_projeto"

# S3/MinIO — obrigatório quando STORAGE_PROVIDER=s3 ou minio.
# S3_ENDPOINT="https://s3.sa-east-1.amazonaws.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="us-east-1"
# S3_FORCE_PATH_STYLE=true

# Docker Compose local — necessário apenas ao executar `npm run db:up`.
# POSTGRES_PASSWORD="substitua-por-uma-senha-forte-e-unica"

# Bootstrap inicial — obrigatório apenas durante `npm run db:seed`.
# Remova INITIAL_ADMIN_PASSWORD do ambiente após o bootstrap.
# INITIAL_ADMIN_NOME=""
# INITIAL_ADMIN_MATRICULA=""
# INITIAL_ADMIN_CPF=""
# INITIAL_ADMIN_EMAIL=""
# INITIAL_ADMIN_PASSWORD=""
