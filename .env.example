POSTGRES_PASSWORD="substitua-por-uma-senha-forte-e-unica"
DATABASE_URL="postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/sadpf_db"
SADPF_SECRET="your_secret_key_here_minimum_32_chars"
NODE_ENV="development"

# E-mail de primeiro acesso (Resend)
# APP_URL=https://sadpf.exemplo.gov.br
# RESEND_API_KEY=re_...
# EMAIL_FROM="SADPF <acesso@sua-organizacao.gov.br>"

# Storage provider: local (padrão), supabase, s3 ou minio
STORAGE_PROVIDER=local

# Local: os PDFs são gravados em ./storage/uploads.
# Em produção, monte esse diretório em um volume persistente do servidor.

# Supabase Storage (obrigatórias quando STORAGE_PROVIDER=supabase)
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_SECRET_KEY=cole_a_service_role_key_aqui
# STORAGE_BUCKET=sadpf-documentos

# S3/MinIO (obrigatórias quando STORAGE_PROVIDER=s3 ou minio)
# S3_ENDPOINT=https://minio.interno.exemplo.gov.br
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true

# Obrigatórias apenas para npm run db:seed; nunca use credenciais de teste em produção.
INITIAL_ADMIN_NOME=
INITIAL_ADMIN_MATRICULA=
INITIAL_ADMIN_CPF=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
