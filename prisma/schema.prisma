generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum StatusServidor {
  Ativo
  Inativo
  Aposentado
}

enum Role {
  ADMIN
  OPERADOR
  PASTA
}

enum CategoriaDocumento {
  Pasta_Fisica_Digitalizada
  Posse_Eletronica
  Documentos_Pessoais
  Publicacoes
  Certidoes_Declaracoes
  Outros
  Processos
}

enum StorageBackend {
  LOCAL
  SUPABASE
  S3
}

enum AcaoAuditoria {
  CONSULTA
  ATUALIZACAO
  EXCLUSAO
  UPLOAD
  IMPRESSAO
  EXPORTACAO
  ENCAMINHAMENTO
}

model Servidor {
  id              String         @id @default(uuid())
  matricula       String         @unique
  matriculaCargoEfetivo String   @default("")
  nome            String
  cpf             String         @unique
  fotoUrl         String?
  fotoStorageBackend StorageBackend?
  fotoStorageKey  String?
  fotoMimeType    String?
  cargoEfetivo    String
  cargoOcupado    String
  lotacao         String
  status          StatusServidor @default(Ativo)
  role            Role           @default(PASTA)
  dataIngresso    String
  email           String         @unique
  telefone        String
  alerta          String         @default("") @db.Text
  senhaHash       String?
  senhaDefinidaEm DateTime?      @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  documentos          DocumentoPDF[]
  encaminhamentos     Encaminhamento[]
  passwordResetTokens PasswordResetToken[]

  @@map("servidores")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  servidorId String

  servidor Servidor @relation(fields: [servidorId], references: [id], onDelete: Cascade)

  @@index([servidorId, expiresAt])
  @@map("password_reset_tokens")
}

model DocumentoPDF {
  id             String             @id @default(uuid())
  servidorId     String
  titulo         String
  categoria      CategoriaDocumento
  dataUpload     String
  tamanho        String
  paginas        Int                @default(1)
  processoSEI    String?
  arquivoUrl     String
  storageBackend StorageBackend?
  storageKey     String?
  operadorRH     String
  ordem          Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  servidor        Servidor         @relation(fields: [servidorId], references: [id], onDelete: Cascade)
  encaminhamentos Encaminhamento[]

  @@index([servidorId, ordem])
  @@index([createdAt])
  @@map("documentos_pdf")
}

model StorageDeletionTask {
  id          String         @id @default(uuid())
  backend     StorageBackend
  storageKey  String         @unique
  attempts    Int            @default(0)
  lastError   String?        @db.Text
  processedAt DateTime?
  createdAt   DateTime       @default(now())

  @@index([processedAt, createdAt])
  @@map("storage_deletion_tasks")
}

model Encaminhamento {
  id            String   @id @default(uuid())
  servidorId    String
  documentoId   String?
  destinatario  String
  validadeDias  Int
  requerSenha   Boolean  @default(true)
  token         String   @unique
  dataGeracao   DateTime @default(now())
  dataExpiracao DateTime
  assinadoEm    DateTime?
  assinadoIp    String?

  servidor  Servidor      @relation(fields: [servidorId], references: [id], onDelete: Cascade)
  documento DocumentoPDF? @relation(fields: [documentoId], references: [id], onDelete: SetNull)

  @@map("encaminhamentos")
  @@index([dataGeracao])
  @@index([dataExpiracao])
  @@index([assinadoEm])
}

model LogAuditoria {
  id                String        @id @default(uuid())
  dataHora          DateTime      @default(now())
  operador          String
  operadorMatricula String
  acao              AcaoAuditoria
  detalhes          String        @db.Text
  ip                String
  createdAt         DateTime      @default(now())

  @@map("logs_auditoria")
  @@index([createdAt])
  @@index([acao, createdAt])
}
